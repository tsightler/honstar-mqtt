#!/command/execlineb -S1
# ==============================================================================
# Acura EV MQTT - Service finish script
# Halt container on critical errors
# See: https://github.com/just-containers/s6-overlay#customizing-s6-behaviour
# ==============================================================================

if -t { /command/s6-test $1 -ne 0 }
if -t { /command/s6-test $1 -ne 256 }
/run/s6/basedir/bin/halt
