# Honstar MQTT Gateway Configuration

# Account credentials (required)
USERNAME=your@email.com
PASSWORD=yourpassword

# Vehicle VIN (optional, uses first vehicle if not specified)
# VIN=YOUR_VIN_HERE

# Vehicle PIN for climate commands (optional)
# PIN=1234

# MQTT broker URL (required)
# Examples:
#   mqtt://192.168.1.100:1883           (no auth)
#   mqtt://user:pass@192.168.1.100:1883 (with auth)
#   mqtts://user:pass@broker.example.com:8883 (TLS)
MQTT_URL=mqtt://user:pass@localhost:1883

# Poll interval in seconds (minimum/default: 900 = 15 minutes)
# POLL_INTERVAL=900

# Enable debug logging (default: false)
# DEBUG=false
